# Sentinel SRE Agent Control Plane Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Infrastructure URLs
DUMMY_API_URL=http://localhost:8001/health
POLICIES_FILE=./policies.json

# Database Configuration (Dedicated Sentinel Control Plane DB - Phase 2)
# When running backend directly on host (e.g. Windows / npm run dev):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sentinel_control
# When running backend inside Docker container network:
# DATABASE_URL=postgresql://postgres:postgres@sentinel-control-db:5432/sentinel_control

# Optional External AI Keys (Autonomous fallback active when omitted)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
